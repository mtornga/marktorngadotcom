# Visit tracker client toggle.
NEXT_PUBLIC_VISIT_NOTIFY_ENABLED=false
NEXT_PUBLIC_VISIT_NOTIFY_HEARTBEAT_SECONDS=15

# Optional client-side host allowlist override.
NEXT_PUBLIC_VISIT_NOTIFY_ALLOWED_HOSTS=marktornga.com,www.marktornga.com

# Pushover settings.
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_ENABLED=true
PUSHOVER_PRIORITY=0

# IP enrichment provider.
IPINFO_TOKEN=

# Server-side host and privacy controls.
VISIT_NOTIFY_ALLOWED_HOSTS=marktornga.com,www.marktornga.com
VISIT_NOTIFY_EXCLUDE_IPS=
VISIT_NOTIFY_EXCLUDE_ASNS=
VISIT_NOTIFY_EXCLUDE_NETWORK_PATTERNS=
VISIT_NOTIFY_HASH_SALT=

# Session tracking controls.
VISIT_NOTIFY_SESSIONS_ENABLED=false
VISIT_NOTIFY_SESSION_IDLE_MINUTES=20
VISIT_NOTIFY_HEARTBEAT_SECONDS=15
VISIT_NOTIFY_SESSION_TTL_DAYS=7
VISIT_NOTIFY_CRON_SECRET=
# Optional Vercel-native cron secret. If set, keep same value as VISIT_NOTIFY_CRON_SECRET.
CRON_SECRET=
VISIT_NOTIFY_FLUSH_LIMIT=200

# Vercel KV / Upstash credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
